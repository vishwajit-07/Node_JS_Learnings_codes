<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Carousels</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body {
  background: #0f172a;
  color: #fff;
  font-family: 'Segoe UI', sans-serif;
}

.header {
  padding: 20px 40px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}

.section {
  margin-bottom: 60px;
}

.carousel img {
  height: 500px;
  object-fit: cover;
  width: 100%;
  border-radius: 20px;
}

.carousel-wrapper {
  position: relative;
  padding: 0 40px;
}

.title {
  font-size: 22px;
  font-weight: 600;
  margin-bottom: 15px;
  padding-left: 40px;
}

.carousel-item {
  position: relative;
}

.carousel-item::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.35);
  border-radius: 20px;
  z-index: 1;
}

.carousel-caption-custom {
  position: absolute;
  top: 75%;
  left: 50%;
  transform: translate(-50%, -50%);
  
  background: rgba(0,0,0,0.6);
  padding: 14px 22px;
  border-radius: 12px;

  text-align: center;
  color: #fff;

  backdrop-filter: blur(8px);
  z-index: 2;
}

.carousel-caption-custom h4 {
  font-size: 45px;
  font-weight: 600;
  margin: 0;
}

.carousel-caption-custom p {
  font-size: 20px;
  margin: 5px 0 0;
}

.carousel-control-prev,
.carousel-control-next {
  width: 5%;
}

.btn-custom {
  background: #fff;
  color: #000;
  border-radius: 50px;
  padding: 8px 20px;
  font-weight: 500;
}

.btn-custom:hover {
  background: #ddd;
}
</style>

</head>

<body>

<div class="header d-flex justify-content-between align-items-center">
  <h3 class="m-0">Carousels</h3>
  <a href="/dashboard" class="btn btn-custom">Dashboard</a>
</div>

<% if (data.length === 0) { %>
  <h4 class="text-danger text-center mt-5">No Data Available</h4>
<% } else { %>

<%- data.map((val, idx) => `

  <div class="section">

    <div class="title">${val.sliderTitle}</div>

    <div class="carousel-wrapper">

      <div id="carousel${idx}" class="carousel slide" data-bs-ride="carousel">
        
        <div class="carousel-inner">

          ${val.sliderImage.map((img, i) => `
            <div class="carousel-item ${i === 0 ? 'active' : ''}">
              
              <img src="/uploads/${img}">

              <div class="carousel-caption-custom">
                <h4>${val.sliderTitle}</h4>
                <p>${val.sliderCaption}</p>
              </div>

            </div>
          `).join('')}

        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#carousel${idx}" data-bs-slide="prev">
          <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#carousel${idx}" data-bs-slide="next">
          <span class="carousel-control-next-icon"></span>
        </button>

      </div>

    </div>

  </div>

`).join('') %>

<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Dashboard</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body {
  background: #0f172a;
  color: #fff;
  font-family: 'Segoe UI', sans-serif;
}

.container-box {
  padding: 30px;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25px;
}

.btn-custom {
  border-radius: 30px;
  padding: 6px 16px;
  font-size: 13px;
}

.table-box {
  border-radius: 12px;
  padding: 15px;
  backdrop-filter: blur(10px);
}

table {
  color: #fff !important;
}


img {
  border-radius: 6px;
}
</style>

</head>

<body>

<div class="container-box">

<div class="header">
  <h4>Dashboard</h4>
  <div>
    <a href="/" class="btn btn-secondary btn-custom">Home</a>
    <a href="/newCrousel" class="btn btn-primary btn-custom">+ Add</a>
  </div>
</div>

<div class="table-box">

<table class="table align-middle">
<thead>
<tr>
<th>#</th>
<th>Title</th>
<th>Caption</th>
<th>Images</th>
<th>Action</th>
</tr>
</thead>

<tbody>

<% if (data.length === 0) { %>
<tr>
<td colspan="5" class="text-center text-danger fw-bold">No Record Found</td>
</tr>
<% } else { %>

<%- data.map((val, idx) => `
<tr>
<td>${idx + 1}</td>
<td>${val.sliderTitle}</td>
<td>${val.sliderCaption}</td>
<td>
  ${val.sliderImage.map(img => `
    <img src="/uploads/${img}" width="60" class="me-1 mb-1">
  `).join('')}
</td>
<td>
<a href="/edit/${val._id}" class="btn btn-warning btn-sm">Edit</a>
<a href="/delete/${val._id}" class="btn btn-danger btn-sm">Delete</a>
</td>
</tr>
`).join('') %>

<% } %>

</tbody>

</table>

</div>

</div>

</body>
</html>
<!DOCTYPE html>
<html>

<head>
  <title>My Content</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    body {
      background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
      font-family: 'Segoe UI', sans-serif;
    }

    .container-box {
      max-width: 900px;
      margin: auto;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .header h3 {
      font-weight: 600;
    }

    .back-btn {
      border-radius: 20px;
    }

    .card {
      border: none;
      border-radius: 15px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }

    .table {
      border-radius: 10px;
      overflow: hidden;
    }

    .table thead {
      background: #000;
      color: #fff;
    }

    .table td,
    .table th {
      vertical-align: middle;
    }

    .table img,
    .table video {
      width: 70px;
      height: 70px;
      object-fit: cover;
      border-radius: 10px;
    }

    .action-btns i {
      font-size: 18px;
      margin-right: 12px;
      cursor: pointer;
      transition: 0.2s;
    }

    .action-btns i:hover {
      transform: scale(1.2);
    }

    .section-title {
      font-weight: 600;
      margin-bottom: 10px;
    }
  </style>
</head>

<body class="p-4">

  <div class="container-box">

    <div class="header">
      <h3 style="color: white;">📊 My Content</h3>
      <a href="/user/dashboard" class="btn btn-dark back-btn">⬅ Back</a>
    </div>

    <div class="card p-3 mb-4">
      <h5 class="section-title">My Posts 📸</h5>

      <table class="table table-hover mt-2">
        <thead>
          <tr>
            <th>#</th>
            <th>Title</th>
            <th>Caption</th>
            <th>Media</th>
            <th>Action</th>
          </tr>
        </thead>

        <tbody>
          <% if (posts.length> 0) { %>
            <% posts.forEach((p, i)=> { %>
              <tr>
                <td>
                  <%= i + 1 %>
                </td>
                <td>
                  <%= p.title %>
                </td>
                <td>
                  <%= p.caption %>
                </td>

                <td>
                  <% const isVideo=/\.(mp4|webm|ogg)$/i.test(p.post); %>

                    <% if (isVideo) { %>
                      <video controls>
                        <source src="/uploads/<%= p.post %>">
                      </video>
                      <% } else { %>
                        <img src="/uploads/<%= p.post %>">
                        <% } %>
                </td>

                <td class="action-btns">
                  <a href="/user/deletePost/<%= p._id %>" onclick="return confirm('Delete this post?')">
                    <i class="bi bi-trash text-danger"></i>
                  </a>
                </td>
              </tr>
              <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="text-center text-muted">No posts found</td>
                  </tr>
                  <% } %>
        </tbody>
      </table>
    </div>

    <div class="card p-3">
      <h5 class="section-title">My Stories 🎥</h5>

      <table class="table table-hover mt-2">
        <thead>
          <tr>
            <th>#</th>
            <th>Caption</th>
            <th>Video</th>
            <th>Action</th>
          </tr>
        </thead>

        <tbody>
          <% if (stories.length> 0) { %>
            <% stories.forEach((s, i)=> { %>
              <tr>
                <td>
                  <%= i + 1 %>
                </td>
                <td>
                  <%= s.caption %>
                </td>

                <td>
                  <video controls>
                    <source src="/uploads/<%= s.story %>">
                  </video>
                </td>

                <td class="action-btns">
                  <a href="/user/deleteStory/<%= s._id %>" onclick="return confirm('Delete this story?')">
                    <i class="bi bi-trash text-danger"></i>
                  </a>
                </td>
              </tr>
              <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="text-center text-muted">No stories found</td>
                  </tr>
                  <% } %>
        </tbody>
      </table>
    </div>

  </div>

</body>

</html>
<!DOCTYPE html>
<html>
  <head>
    <title>Signup</title>

    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background-color: #eaeded;
      }

      .auth-container {
        width: 350px;
        margin: 60px auto;
        background: #fff;
        padding: 25px;
        border: 1px solid #ddd;
        border-radius: 5px;
      }

      .logo {
        text-align: center;
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 20px;
      }

      h2 {
        margin-bottom: 15px;
      }

      input {
        width: 100%;
        padding: 8px;
        margin: 6px 0 12px;
        border: 1px solid #ccc;
        border-radius: 3px;
      }

      button {
        width: 100%;
        background: #ffd814;
        border: none;
        padding: 10px;
        cursor: pointer;
        border-radius: 3px;
      }

      button:hover {
        background: #f7ca00;
      }

      a {
        color: #0066c0;
        text-decoration: none;
      }

      .small {
        font-size: 12px;
        color: #555;
        margin-top: 10px;
      }
    </style>
  </head>
  <body>
    <div class="auth-container">
      <div class="logo">amazon</div>

      <h2>Create Account</h2>

      <form action="/signup" method="POST" enctype="multipart/form-data">
        <label>Username</label>
        <input type="text" name="userName" required />

        <label>Email</label>
        <input type="email" name="userEmail" required />

        <label>Password</label>
        <input type="password" name="password" required />

        <label>Phone</label>
        <input type="userPhone" name="userPhone" required />

        <label>Profile</label>
        <input type="file" name="profile" required />

        <button type="submit">Register</button>
      </form>

      <p class="small">Already have an account? <a href="/">Login</a></p>
    </div>
  </body>
</html>

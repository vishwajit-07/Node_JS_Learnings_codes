<!DOCTYPE html>
<html>
  <head>
    <title>Dashboard</title>

    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background-color: #eaeded;
      }

      .header {
        background: #131921;
        color: #fff;
        padding: 15px 20px;
        font-size: 20px;
      }

      .dashboard {
        padding: 20px;
      }

      .card-container {
        display: flex;
        gap: 20px;
        margin-top: 20px;
      }

      .card {
        background: #fff;
        padding: 20px;
        border: 1px solid #ddd;
        flex: 1;
        border-radius: 5px;
        transition: 0.3s;
      }

      .card:hover {
        transform: scale(1.05);
      }
    </style>
  </head>
  <body>
    <div class="header">Amazon Dashboard</div>

    <div class="dashboard">
      <h3>Welcome User 👋</h3>

      <div class="card-container">
        <div class="card">Orders</div>
        <div class="card">Wishlist</div>
        <div class="card">Profile</div>
      </div>
    </div>
  </body>
</html>
